# WRD File Tracker — environment template.
# Copy to .env for local builds. EAS builds do NOT read .env (it is git-ignored);
# register the same variables per environment with `eas env:create` (see README).

EXPO_PUBLIC_API_BASE_URL=https://goawrd.gov.in/file-tracker
EXPO_PUBLIC_CSV_DIRECTORY_URL=https://docs.google.com/spreadsheets/d/e/<sheet-id>/pub?gid=<gid>&single=true&output=csv

# SHA-256 of the department password — never the password itself.
# Generate with: npm run hash-password -- "<password>"
EXPO_PUBLIC_ADMIN_PASSWORD_HASH=
